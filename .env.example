# Konstellation testnet-1 faucet — copy to .env (git-ignored) and fill in.
# Every value is read from the environment; nothing is read from a file.

# --- required ---------------------------------------------------------------
# 32-byte hex private key of the faucet account (the testnet "liquidity"
# bucket, TOKENOMICS.md §7 / ENGINEERING.md §18). Inject as a secret in
# deployment; never commit it. The public dev0 key below works ONLY against a
# local `./local_node.sh` chain (chain id 56670).
FAUCET_PRIVATE_KEY=
# Ethereum JSON-RPC endpoint of a testnet-1 node (the infra RPC node, not a validator).
RPC_URL=https://rpc.testnet-1.konstellation.network

# --- chain --------------------------------------------------------------------
# EIP-155 id. Default 56671 = testnet-1. 56670 = local dev chain. 5667 (mainnet) is refused.
CHAIN_ID=56671
# Human name shown on the page. Defaults to "testnet-1" for 56671.
#NETWORK_NAME=testnet-1
#BECH32_PREFIX=kons

# --- payout policy ------------------------------------------------------------
# KASH per request. Default 10 (placeholder until a real testnet-1 policy is set);
# hard-capped at 1000 by the service regardless of this value.
AMOUNT_KASH=10
# Per-address and per-IP cooldown, seconds. Default 86400 (24 h).
COOLDOWN_SECONDS=86400
# /healthz reports "degraded" below this balance. Default 100 × AMOUNT_KASH.
#LOW_BALANCE_KASH=1000

# --- HTTP ---------------------------------------------------------------------
PORT=8080
#HOST=0.0.0.0
# Comma-separated origins allowed to call the API cross-origin. Empty = none
# (the built-in page is same-origin and needs nothing here). "*" is refused
# unless NODE_ENV=development.
ALLOWED_ORIGINS=
# Read the client IP from X-Forwarded-For. Only behind a proxy you control.
TRUST_PROXY=false
# Explorer link template for the result, "{hash}" is replaced.
#EXPLORER_TX_URL=https://explorer.testnet-1.konstellation.network/tx/{hash}

# --- rate-limit store ---------------------------------------------------------
# memory (default, single replica) or redis (shared; needs `npm install redis`).
RATE_LIMIT_STORE=memory
#REDIS_URL=redis://localhost:6379

# --- captcha (optional, off by default) ---------------------------------------
# off | hcaptcha | turnstile. When set, both keys are required and the page
# renders the provider's widget.
CAPTCHA_PROVIDER=off
#CAPTCHA_SITE_KEY=
#CAPTCHA_SECRET=
